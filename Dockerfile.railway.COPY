# Dockerfile qui COPIE l'exécutable depuis l'image officielle
FROM kestra/kestra:latest as kestra-source

# Image finale
FROM eclipse-temurin:21-jre-jammy

# Copier l'exécutable depuis l'image source
COPY --from=kestra-source /usr/local/bin/kestra /app/kestra

# Copier les libs depuis l'image source
COPY --from=kestra-source /usr/local/lib/kestra /app/lib/

# Créer les répertoires nécessaires
RUN mkdir -p /app/storage /tmp/kestra-wd/tmp

# Rendre l'exécutable exécutable
RUN chmod +x /app/kestra

# Variables d'environnement
ENV KESTRA_CONFIGURATION="datasources:\n  postgres:\n    url: jdbc:postgresql://postgres:5432/kestra\n    driverClassName: org.postgresql.Driver\n    username: kestra\n    password: k3str4\nkestra:\n  repository:\n    type: postgres\n  storage:\n    type: local\n    local:\n      basePath: \"/app/storage\"\n  queue:\n    type: postgres\n  tasks:\n    tmpDir:\n      path: /tmp/kestra-wd/tmp\n  url: http://localhost:8080/"

# Vérifier que l'exécutable existe
RUN ls -la /app/kestra && /app/kestra --version

# Ports exposés
EXPOSE 8080 8081

# Commande de démarrage
CMD ["/app/kestra", "server", "standalone"]
