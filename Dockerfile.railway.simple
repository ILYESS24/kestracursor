# Dockerfile simple pour Railway
FROM kestra/kestra:latest

# Vérifier où se trouve l'exécutable Kestra
RUN find / -name "kestra" -type f 2>/dev/null || echo "Kestra executable not found"

# Lister le contenu de /app
RUN ls -la /app/ || echo "No /app directory"

# Lister le contenu de /usr/local/bin
RUN ls -la /usr/local/bin/ || echo "No /usr/local/bin directory"

# Créer un lien symbolique si nécessaire
RUN if [ -f /usr/local/bin/kestra ]; then \
        ln -sf /usr/local/bin/kestra /app/kestra; \
    fi

# Vérifier que l'exécutable fonctionne
RUN /usr/local/bin/kestra --version || echo "Kestra version check failed"

# Variables d'environnement
ENV KESTRA_CONFIGURATION="datasources:\n  postgres:\n    url: jdbc:postgresql://postgres:5432/kestra\n    driverClassName: org.postgresql.Driver\n    username: kestra\n    password: k3str4\nkestra:\n  repository:\n    type: postgres\n  storage:\n    type: local\n    local:\n      basePath: \"/app/storage\"\n  queue:\n    type: postgres\n  tasks:\n    tmpDir:\n      path: /tmp/kestra-wd/tmp\n  url: http://localhost:8080/"

# Ports
EXPOSE 8080 8081

# Commande de démarrage
CMD ["/usr/local/bin/kestra", "server", "standalone"]
