# Dockerfile ULTIME - On va trouver où est vraiment Kestra !
FROM kestra/kestra:latest

# Trouver où est vraiment l'exécutable Kestra
RUN find / -name "*kestra*" -type f 2>/dev/null | head -20

# Lister tout le contenu de l'image
RUN echo "=== CONTENU DE / ===" && ls -la / && \
    echo "=== CONTENU DE /app ===" && ls -la /app/ 2>/dev/null || echo "Pas de /app" && \
    echo "=== CONTENU DE /usr/local/bin ===" && ls -la /usr/local/bin/ 2>/dev/null || echo "Pas de /usr/local/bin" && \
    echo "=== CONTENU DE /usr/bin ===" && ls -la /usr/bin/ 2>/dev/null || echo "Pas de /usr/bin" && \
    echo "=== CONTENU DE /bin ===" && ls -la /bin/ 2>/dev/null || echo "Pas de /bin"

# Essayer de trouver l'exécutable Java
RUN find / -name "java" -type f 2>/dev/null | head -5

# Essayer de lancer Kestra avec java directement
RUN find / -name "*.jar" | grep -i kestra | head -5

# Variables d'environnement
ENV KESTRA_CONFIGURATION="datasources:\n  postgres:\n    url: jdbc:postgresql://postgres:5432/kestra\n    driverClassName: org.postgresql.Driver\n    username: kestra\n    password: k3str4\nkestra:\n  repository:\n    type: postgres\n  storage:\n    type: local\n    local:\n      basePath: \"/app/storage\"\n  queue:\n    type: postgres\n  tasks:\n    tmpDir:\n      path: /tmp/kestra-wd/tmp\n  url: http://localhost:8080/"

# Ports
EXPOSE 8080 8081

# Commande qui va nous dire où est Kestra
CMD ["sh", "-c", "echo 'Recherche de Kestra...' && find / -name '*kestra*' -type f 2>/dev/null && echo 'Fin de recherche' && sleep 3600"]
